+        } => Some(ProgressEvent::SubagentCompleted {
+            stage_node_id: node_id,
+            agent_id:      agent_id.clone(),
+            success:       *success,
+            turns_used:    *turns_used as u64,
+        }),
+        _ => None,
     }
