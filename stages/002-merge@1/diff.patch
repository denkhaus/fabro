+    "agent.sub.turn.started",
+    "agent.sub.completed",
+    "agent.sub.failed",
+    "agent.sub.closed",
+    "agent.memory.loaded",
+    "agent.skills.discovered",
+    "agent.skill.activated",
+    "todo.created",
+    "todo.updated",
+    "todo.deleted",
+    "agent.event",
+];
+
+/// Whether `name` is a run event name derived from a pebble event.
+#[must_use]
+pub fn is_coding_event_name(name: &str) -> bool {
+    CODING_EVENT_NAMES.contains(&name)
