+    "agent.tool.rounds.exhausted",
+    "agent.route.failover",
+    "agent.mcp.server.ready",
+    "agent.mcp.server.failed",
+    "agent.steering.injected",
+    "agent.round.interrupted",
+    "agent.compaction.started",
