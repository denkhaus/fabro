+            { ...parallelStage, id: "branch-b@1", name: "branch-b", nodeId: "branch-b", handler: "agent", status: "failed" },
+          ]}
+        />
+      </MemoryRouter>,
+    );
+  });
+  return renderer;
+}
+
+describe("ParallelChildren", () => {
