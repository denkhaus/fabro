+    #[test]
+    fn header_rejects_env_var_outside_allowlist() {
+        let definition = http_hook(
+            "https://hooks.example.com",
+            &[("Authorization", "Bearer {{ env.HOOK_KEY }}")],
+            &[],
+        );
+
+        let err = definition
+            .resolve_env(
