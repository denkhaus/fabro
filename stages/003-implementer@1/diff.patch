+// wantPrettyLine returns the expected pretty-text line for index i when
+// count numbers are printed: index and value right-aligned to the width
+// of the largest index (count) and, because Fib is monotonic, the
+// largest value Fib(count), separated by ": ".
+func wantPrettyLine(i, count int) string {
+	pad := func(s string, w int) string {
+		return strings.Repeat(" ", w-len(s)) + s
+	}
+	return pad(fmt.Sprint(i), len(fmt.Sprint(count))) + ": " +
+		pad(Fib(i).String(), len(Fib(count).String()))
+}
+
+// prettyLines returns the expected pretty-text lines for count numbers.
+func prettyLines(count int) []string {
+	lines := make([]string, count)
+	for i := 1; i <= count; i++ {
+		lines[i-1] = wantPrettyLine(i, count)
+	}
+	return lines
+}
+
+func TestRunPrettyText(t *testing.T) {
+	tests := []struct {
+		name    string
+		n       int
+		wantAll []string
+	}{
+		// Widths come from the 5th line (idxW=1, valW=1), so none of
+		// the five lines carries padding.
+		{"pretty n=5 aligns to the 5th line", 5,
+			[]string{"1: 1", "2: 1", "3: 2", "4: 3", "5: 5"}},
+		// Widths come from the 100th line (idxW=3, valW=21): earlier
+		// lines are padded, the last is flush. Expected lines are
+		// computed; F(100) is pinned by TestFib.
+		{"pretty default aligns 100 lines", defaultCount, prettyLines(defaultCount)},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := run(&buf, tt.n, false, true); err != nil {
+				t.Fatalf("run(%d, pretty) returned error: %v", tt.n, err)
+			}
+			lines := strings.Split(strings.TrimSuffix(buf.String(), "\n"), "\n")
+			if len(lines) != len(tt.wantAll) {
+				t.Fatalf("run(%d, pretty) printed %d lines, want %d", tt.n, len(lines), len(tt.wantAll))
+			}
+			for i, line := range lines {
+				if line != tt.wantAll[i] {
+					t.Errorf("line %d = %q, want %q", i+1, line, tt.wantAll[i])
+				}
+			}
+		})
+	}
+}
