+package main
+
+import (
+	"math/big"
+	"testing"
+)
+
+func TestFib(t *testing.T) {
+	f100, ok := new(big.Int).SetString("354224848179261915075", 10)
+	if !ok {
+		t.Fatal("test fixture: F(100) literal is not a valid decimal number")
+	}
+
+	tests := []struct {
+		name string
+		n    int
+		want *big.Int
+	}{
+		{"F(1)", 1, big.NewInt(1)},
+		{"F(2)", 2, big.NewInt(1)},
+		{"F(10)", 10, big.NewInt(55)},
+		{"F(100)", 100, f100},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := Fib(tt.n)
+			if got == nil {
+				t.Fatalf("Fib(%d) = nil, want %s", tt.n, tt.want)
+			}
+			if got.Cmp(tt.want) != 0 {
+				t.Errorf("Fib(%d) = %s, want %s", tt.n, got, tt.want)
+			}
+		})
+	}
+}
