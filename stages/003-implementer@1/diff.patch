+// Command gofib prints the first 100 Fibonacci numbers, one per line,
+// each prefixed with its 1-based index: "<index>: <value>".
+package main
+
+import (
+	"fmt"
+	"math/big"
+)
+
+// defaultCount is how many Fibonacci numbers gofib prints when run
+// without arguments.
+const defaultCount = 100
+
+// Fib returns the n-th Fibonacci number, 1-indexed: Fib(1) = 1,
+// Fib(2) = 1, Fib(3) = 2, ... It uses math/big because Fibonacci
+// numbers quickly outgrow int64 (F(93) is the last that fits).
+// Fib returns nil for n < 1.
+func Fib(n int) *big.Int {
+	if n < 1 {
+		return nil
+	}
+	a, b := big.NewInt(0), big.NewInt(1)
+	for range n - 1 {
+		a.Add(a, b)
+		a, b = b, a
+	}
+	return b
+}
+
+func main() {
+	for i := 1; i <= defaultCount; i++ {
+		fmt.Printf("%d: %v\n", i, Fib(i))
+	}
+}
