+// wantPrettyLines returns the expected -pretty text output for the first
+// n numbers: index and value each right-aligned to the width of the
+// largest index and value (the ones on the n-th line), separated by
+// ": ". Padding is built explicitly so the expected strings do not
+// depend on the implementation's formatting.
+func wantPrettyLines(n int) []string {
+	idxW := len(strconv.Itoa(n))
+	valW := len(Fib(n).String())
+	lines := make([]string, n)
+	for i := 1; i <= n; i++ {
+		idx := strconv.Itoa(i)
+		val := Fib(i).String()
+		lines[i-1] = strings.Repeat(" ", idxW-len(idx)) + idx + ": " +
+			strings.Repeat(" ", valW-len(val)) + val
+	}
+	return lines
+}
+
+func TestRunPretty(t *testing.T) {
+	tests := []struct {
+		name string
+		n    int
+	}{
+		{"pretty n=5 prints five padded lines", 5},
+		// The default pretty path still prints 100 numbers; the exact
+		// last line (and every line before it) is computed, not hardcoded.
+		{"pretty default prints 100 lines", defaultCount},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := run(&buf, tt.n, false, true); err != nil {
+				t.Fatalf("run(%d, pretty) returned error: %v", tt.n, err)
+			}
+			got := strings.Split(strings.TrimSuffix(buf.String(), "\n"), "\n")
+			want := wantPrettyLines(tt.n)
+			if len(got) != len(want) {
+				t.Fatalf("run(%d, pretty) printed %d lines, want %d", tt.n, len(got), len(want))
+			}
+			for i := range want {
+				if got[i] != want[i] {
+					t.Errorf("line %d = %q, want %q", i+1, got[i], want[i])
+				}
+			}
+		})
+	}
+}
+
+func TestRunPrettyJSONMatchesJSON(t *testing.T) {
+	var pretty, plain bytes.Buffer
+	if err := run(&pretty, 3, true, true); err != nil {
+		t.Fatalf("run(3, json, pretty) returned error: %v", err)
+	}
+	if err := run(&plain, 3, true, false); err != nil {
+		t.Fatalf("run(3, json) returned error: %v", err)
+	}
+	if pretty.String() != plain.String() {
+		t.Errorf("-pretty -json output %q differs from -json output %q", pretty.String(), plain.String())
+	}
+	lines := strings.Split(strings.TrimSuffix(pretty.String(), "\n"), "\n")
+	for i, line := range lines {
+		if want := wantJSONLine(i + 1); line != want {
+			t.Errorf("line %d = %q, want exactly %q", i+1, line, want)
+		}
+	}
+}
