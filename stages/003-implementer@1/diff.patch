+		if asJSON {
+			if err := enc.Encode(fibLine{Index: i, Fib: Fib(i).String()}); err != nil {
+				return err
+			}
+		} else {
+			fmt.Fprintf(w, "%d: %v\n", i, Fib(i))
+		}
 	}
 	return nil
 }
 
