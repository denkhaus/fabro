+// wantPrettyLine returns the expected -pretty text line for index i when
+// count numbers are printed: index and value are right-aligned in columns
+// as wide as the largest index (count) and the largest value (Fib(count)),
+// separated by ": ". Nothing is hardcoded — widths and values are derived
+// from the same Fib the code under test uses.
+func wantPrettyLine(i, count int) string {
+	return fmt.Sprintf("%*d: %*s",
+		len(strconv.Itoa(count)), i,
+		len(Fib(count).String()), Fib(i).String())
+}
+
+func TestRunPretty(t *testing.T) {
+	tests := []struct {
+		name string
+		n    int
+	}{
+		// n=5: widths come from the 5th line, so every line is expected
+		// exactly, padding included.
+		{"pretty n=5 prints the exact aligned five-line block", 5},
+		// Default count: all 100 lines are checked, which pins the count
+		// and the exact last line (no padding on the widest line).
+		{"pretty default prints 100 aligned numbers", defaultCount},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := run(&buf, tt.n, false, true); err != nil {
+				t.Fatalf("run(%d, pretty) returned error: %v", tt.n, err)
+			}
+			lines := outputLines(buf.String())
+			if len(lines) != tt.n {
+				t.Fatalf("run(%d, pretty) printed %d lines, want %d", tt.n, len(lines), tt.n)
+			}
+			for i, line := range lines {
+				if want := wantPrettyLine(i+1, tt.n); line != want {
+					t.Errorf("line %d = %q, want exactly %q", i+1, line, want)
+				}
+			}
+		})
+	}
+}
+
+func TestRunPrettyJSON(t *testing.T) {
+	// -pretty affects text mode only: JSON Lines output must be byte-for-
+	// byte identical to plain -json for the same count.
+	var prettyBuf, plainBuf bytes.Buffer
+	if err := run(&prettyBuf, 3, true, true); err != nil {
+		t.Fatalf("run(3, json, pretty) returned error: %v", err)
+	}
+	if err := run(&plainBuf, 3, true, false); err != nil {
+		t.Fatalf("run(3, json) returned error: %v", err)
+	}
+	pretty, plain := outputLines(prettyBuf.String()), outputLines(plainBuf.String())
+	if len(pretty) != 3 || len(plain) != 3 {
+		t.Fatalf("pretty json printed %d lines, plain json %d, want 3 each", len(pretty), len(plain))
+	}
+	for i := range plain {
+		if pretty[i] != plain[i] {
+			t.Errorf("line %d differs: pretty json %q, plain json %q", i+1, pretty[i], plain[i])
+		}
+		if want := wantJSONLine(i + 1); pretty[i] != want {
+			t.Errorf("line %d = %q, want exactly %q", i+1, pretty[i], want)
+		}
+	}
+}
