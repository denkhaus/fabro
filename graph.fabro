digraph Hello {
    graph [goal="Say hello and demonstrate a basic Fabro workflow"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    greet [label="Greet", prompt="Add a short haiku to README.md (create the file if missing). Do not build, test, or run any project tooling; this is a tiny edit-only task."]

    start -> greet -> exit
}
