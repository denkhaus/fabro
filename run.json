          "provider": "docker",
          "image": {
            "docker": null,
            "dockerfile": {
              "type": "inline",
              "value": "# Lab runner image, built on demand by fabro (image.dockerfile).\n#\n# Content-hash tagged by fabro (fabro-runner-<sha12>) and rebuilt only\n# when this file changes; docker layer cache keeps incremental rebuilds\n# cheap. The build context is EMPTY (fabro limitation): .mise.toml cannot\n# be COPY'd, so the toolset below mirrors [tools] in .mise.toml — keep\n# both in sync (bun/nushell/go/just/ripgrep versions MUST match). ripgrep\n# rides the mise aqua backend (NOT apt): one tool source, same pin in both\n# files, agent search tools resolve through the shims like every other\n# tool (run 01M0SS23MJ planner burned 4-5 calls on a missing rg).\n#\n# Restores what fabro-meta-a7c3 asked for: tools baked in, per-run\n# `mise install` becomes a no-op version check instead of ~24.5s setup.\nFROM ubuntu:24.04\n\nARG MISE_VERSION=v2026.8.10\n\nENV MISE_DATA_DIR=/mise \\\n    BUN_INSTALL=/mise/bun-global \\\n    PATH=/usr/local/bin:/mise/shims:/mise/bun-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n\n# Sandbox requirements (bash, git) + mise itself.\nRUN set -eux; \\\n    apt-get update; \\\n    apt-get install -y --no-install-recommends bash git ca-certificates curl xz-utils; \\\n    rm -rf /var/lib/apt/lists/*; \\\n    curl -fsSL \"https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-linux-x64\" \\\n        -o /usr/local/bin/mise; \\\n    chmod +x /usr/local/bin/mise; \\\n    mise --version\n\n# Workspace toolset, mirroring .mise.toml [tools] (see header note).\n# `mise use -g` sets global defaults (needed: shims resolve versions from\n# config; the empty context has no .mise.toml to copy) and installs. The\n# workspace .mise.toml pins the same versions for runs, so per-run\n# `mise install` stays a no-op check.\nRUN mise use -g \\\n        bun@1.4.0 \\\n        aqua:nushell/nushell@0.115.0 \\\n        go@1.27.0 \\\n        just@1.58.0 \\\n        aqua:BurntSushi/ripgrep@15.2.0 \\\n    && bun --version \\\n    && nu --version \\\n    && go version \\\n    && just --version \\\n    && rg --version\n\n# npm-distributed CLIs into the pinned BUN_INSTALL dir (see\n# scripts/bootstrap.nu): sd + ml available without per-run install.\nRUN mise exec -- bun install -g \\\n        @os-eco/seeds-cli@0.5.15 \\\n        @os-eco/mulch-cli@0.10.7 \\\n    && sd --version \\\n    && ml --version\n"
            }
          },
