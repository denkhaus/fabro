digraph Develop {
    graph [
        goal="Develop the project seed-by-seed: plan from the tracker, implement, gate, review, repeat until no open seed remains",
        rankdir=LR,
        max_node_visits=40
    ]

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Planner: reads the seeds tracker, decides what is implemented next,
    // claims the seed and hands a brief to the implementer.
    // Outcome: succeeded = seed claimed, failed = tracker empty for this effort.
    planner [
        label="Planner",
        prompt="@prompts/planner.md",
        output_schema="routing",
        output_retries=2,
        max_visits=20
    ]

    // Implementer: builds exactly what the claimed seed specifies.
    // Outcome: succeeded = implemented (gate judges next), failed = seed blocked.
    implementer [
        label="Implementer",
        prompt="@prompts/implementer.md",
        output_schema="routing",
        output_retries=2,
        max_visits=10
    ]

    // Tester: deterministic quality gate, no agent.
    // Outcome: exit code of `just qualitygate` (0 = succeeded).
    tester [
        label="Quality Gate",
        shape=parallelogram,
        script="nu .fabro/workflows/develop/scripts/gate.nu",
        timeout="10m",
        max_retries=0
    ]

    // Reviewer: audits the pass against the seed; approval closes the seed.
    // Outcome: succeeded = approved, failed = changes requested.
    reviewer [
        label="Reviewer",
        prompt="@prompts/reviewer.md",
        output_schema="routing",
        output_retries=2,
        max_visits=20
    ]

    start -> planner

    planner -> exit        [label="Tracker empty", condition="outcome=failed"]
    planner -> implementer [label="Seed claimed"]

    implementer -> planner  [label="Blocked", condition="outcome=failed"]
    implementer -> tester   [label="Implemented"]

    tester -> reviewer    [label="Gate green", condition="outcome=succeeded"]
    tester -> implementer [label="Gate red"]

    reviewer -> planner [label="Approved", condition="outcome=succeeded"]
    reviewer -> planner [label="Changes requested"]
}
