digraph Adjudicator {
    graph [
        goal="Adjudicate the develop line's terminal runs: sweep the merge queue, mark the trivial mass, judge the rest, park true policy forks for the operator",
        rankdir=LR,
        // The fast path's batch sweep is bounded by the queue page (200
        // runs x 2 reads each over the run channel); the agent pass
        // works packets serially. The 30m ceiling leaves room for a
        // full page without tripping the default watchdog mid-pass.
        stall_timeout="31m",
        max_node_visits=40,
        x.preamble_budget_kb=24,
    ]

    start [shape=Mdiamond, label="Start"]
    // Exit kinds: soft exits classify the terminal event; a failed pass
    // leaves every unadjudicated run queued (the anti-join is gap-safe,
    // the next pass re-enters cleanly — no cleanup path exists).
    exit  [shape=Msquare, label="Exit"]

    // Toolchain-placement guard (the develop lane's pattern): a manual
    // fire WITHOUT --environment falls to the server default and dies
    // cryptically at the first nu stage. POSIX sh, NOT nu: the failure
    // mode it guards is a sandbox without nu. Fail-closed with a
    // teaching error naming the correct fire command.
    env_guard [
        label="Toolchain guard: fail-closed placement check",
        shape=parallelogram,
        script="sh .fabro/scripts/toolchain-guard.sh adjudicator",
        timeout="30s",
        max_retries=0
    ]

    // The fast path (stage D part 2, grilled batch sweep): ONE LLM-free
    // command stage walks the whole worklist — terminal develop runs
    // whose latest merge verdict is not settled — marks the trivial
    // mass directly (with pull request -> enabled, without -> refused;
    // no painpoints after fact-head dedupe, empty radius), and emits
    // the non-trivial runs as packets through output.adjudication.
    // Parked runs re-enter as packets: an open operator escalation is
    // a judgment, never a mechanical skip. Every door call is HARD (a
    // failed call fails the stage; the engine retries the sweep — the
    // anti-join makes re-sweeps gap-safe).
    fast_path [
        label="Fast path: sweep the queue, mark the trivial mass",
        shape=parallelogram,
        script="nu .fabro/workflows/adjudicator/scripts/fast-path.nu",
        output_schema="routing",
        x.context_allow_keys="output.adjudication",
        timeout="10m",
        max_retries=1
    ]

    // The agent pass: works the packets one per visit, serially — the
    // evidence pipe lands the fast path's packets in ## Context, and
    // the parity tools (fabro_run_queue, fabro_observation_list,
    // fabro_work_radius, fabro_work_comments) fetch whatever the
    // packets summarize. Judgments: merge verdicts through
    // fabro_run_mark (enabled / refused / parked), follow-up work
    // items through fabro_work_create, the fork question as an
    // observation note on THIS run when parking (the verdict record's
    // by_run links the next pass to it). The pass NEVER waits on the
    // operator: a policy fork parks and the sweep continues; the
    // terminal notification names the parked count for the operator.
    adjudicate [
        label="Adjudicate: verdicts, follow-ups, parks",
        prompt="@prompts/adjudicate.md",
        output_schema="routing",
        output_retries=2,
        max_visits=30,
        retry_policy="standard",
        reasoning_effort="low",
        fidelity="summary:high",
        x.preamble_stages_ignore="adjudicate",
        x.preamble_allow_keys="output.adjudication",
        x.context_allow_keys="output.adjudication,journal",
        // Read-only over the tree: the adjudicator judges runs, it
        // never edits the repository. Every write goes through the
        // platform doors.
        x.tools="read_file,grep,glob",
        x.fs_write="",
        // The pass-one toolbox: verdicts (fabro_run_mark), the read
        // doors' tool twins (door symmetry), follow-up filings, and
        // the observation recorder (the presence contract — every
        // agent session records its observations through the tool).
        x.fabro_tools="fabro_run_mark,fabro_run_queue,fabro_observation_list,fabro_work_radius,fabro_work_comments,fabro_work_create,fabro_work_show,fabro_work_list,fabro_observation_record",
        x.observations="required"
    ]

    start -> env_guard
    env_guard -> fast_path

    // The empty worklist is natural completion: every terminal develop
    // run carries a settled verdict.
    fast_path -> exit [label="Queue empty", condition="preferred_label=\"Queue empty\""]
    fast_path -> adjudicate [label="Runs pending adjudication"]

    // The pass works packets serially; a verdict on one run routes the
    // next visit. The self-edge is bounded by max_visits and the
    // generation caps below.
    adjudicate -> adjudicate [label="Next run", condition="preferred_label=\"Next run\""]
    adjudicate -> exit [label="Queue settled", condition="preferred_label=\"Queue settled\""]
    // A policy fork parks the run and CONTINUES: the sweep never waits
    // on a human. The same edge covers a parked run the operator
    // resolved through the tracker — the next pass re-adjudicates it.
    adjudicate -> adjudicate [label="Parked a fork, continue", condition="preferred_label=\"Parked a fork\""]
    // Structural guards: the worklist self-loop is bounded by
    // max_visits (a full page of packets) and outcome=failed — a
    // GENERATION guard would cut a healthy long pass mid-worklist
    // (every packet visit increments it), so none sits here. The
    // anti-join keeps every unadjudicated run queued for the next
    // pass.
    adjudicate -> exit [x.kind="soft", label="Adjudicate failed (queue stays, next pass re-enters)", condition="outcome=failed"]
    // Unconditional safety net (the engine requires one): an unrouted
    // adjudication outcome exits softly — no verdict happens silently,
    // the queue keeps the run for the next pass.
    adjudicate -> exit [x.kind="soft", label="Unrouted adjudication outcome (queue stays)"]
    fast_path -> exit [x.kind="soft", label="Fast path failed (queue stays, next pass re-enters)", condition="outcome=failed"]
}
