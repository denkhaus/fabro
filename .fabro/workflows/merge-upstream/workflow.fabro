digraph MergeUpstream {
    graph [
        goal="Merge upstream/main into denkhaus per the conflict policy, gate the merged tree, and report; deploy is host-side",
        rankdir=LR,
        max_node_visits=6,
        preamble_budget_kb=12,
        cycle_counter_reset_key="merge_target_sha"
    ]

    start [shape=Mdiamond, label="Start"]
    // Soft exits: tool failures leave the run branch unmerged; the
    // conductor defers to manual /merge-upstream for hard conflicts.
    exit  [shape=Msquare, label="Exit"]

    // Merge: fetch upstream, merge --no-commit, resolve conflicts per
    // .agents/skills/merge-upstream/references/conflict-policy.md (our
    // features AND upstream changes both survive), run the full
    // qualitygate, write the report artifact. The engine pushes the run
    // branch and opens the PR; the Dogfood Gate (full Rust+TS program
    // for code paths) gates the auto-merge.
    merge [
        label="Merge",
        prompt="@prompts/merge.md",
        output_schema="routing",
        output_retries=2,
        retry_policy="standard",
        reasoning_effort="high",
        project_memory=false,
        preamble_stages_ignore="merge",
        // No fs_write restriction: the merger writes the WHOLE tree
        // (conflict resolution, gate fixes, report). An empty allowlist
        // would block every tool write and force shell-only workarounds
        // (2026-09-05, first autonomous merge run 01M1SR27KEJGNQ).
        fabro_tools=""
    ]


    // Reviewer (user directive 2026-09-05 evening): an upstream merge is a
    // normal implementation and gets reviewed BEFORE it can merge — our
    // features must survive upstream changes. The engine creates the PR
    // only on run success, so a rejected review fails the run and NOTHING
    // merges unreviewed. Two-agent separation: the merger never judges its
    // own merge.
    reviewer [
        label="Review merge",
        prompt="@prompts/review.md",
        output_schema="routing",
        output_retries=2,
        retry_policy="standard",
        reasoning_effort="high",
        project_memory=false,
        preamble_stages_ignore="merge,reviewer",
        fs_write="",
        fabro_tools=""
    ]

    start -> merge
    merge -> reviewer [label="Merged and gated", condition="outcome=succeeded"]
    reviewer -> exit [label="Approved", condition="preferred_label=\"Approved\""]
    // Review requests changes: back to the merger with the objections in
    // review_feedback; the reviewer's verdict travels via context like
    // develop's cycle.
    reviewer -> merge [label="Changes requested", condition="preferred_label=\"Changes requested\""]
    reviewer -> exit [kind="soft", label="Review blocked — manual /merge-upstream takes over", condition="preferred_label=\"Verification blocked\""]
    // Unconditional safety net: an unrouted review outcome fails softly —
    // nothing merges on an ambiguous verdict.
    reviewer -> exit [kind="soft", label="Unrouted review outcome"]
    merge -> exit [kind="soft", label="Merge failed (manual /merge-upstream takes over)"]
}
