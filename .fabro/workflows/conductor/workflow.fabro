digraph Conductor {
    graph [
        goal="Run the serialized fabro line: one pass = upstream merge (when the threshold is met, infra-only) OR one develop+revisor cycle; children are created only after the previous child merged",
        x.inspects="develop,merge-upstream,revisor",
        rankdir=LR,
        // fabro-0e11: legal blocking fabro_run_wait (60m) and long gate shells
        // must not trip the default 1800s stall watchdog.
        stall_timeout="63m",
        max_node_visits=12,
        x.preamble_budget_kb=12,
        x.cycle_counter_reset_key="pass_id"
    ]

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    // Survey (cheap): count unrevised upstream commits. MIN threshold
    // 5 (user decision 2026-09-05): single-commit upstream drifts must
    // not consume merge slots that product cycles need.
    survey [
        label="Survey",
        prompt="@prompts/survey.md",
        // fabro-f84f: opt into vendored-skill discovery — the
        // session loads `.fabro/skills` (rust-style-guide and
        // friends) through the UseSkill tool.
        x.skills="discover",
        output_schema="routing",
        output_retries=2,
        retry_policy="standard",
        reasoning_effort="low",
        project_memory=false,
        x.preamble_stages_ignore="survey",
        x.fs_write="",
        // fabro_workflow_version_create (fabro-978d): the survey
        // pre-registers the develop + revisor workflow versions while it
        // has slack, so the legs pass only the content-addressed id
        // instead of transcribing ~118 KB of closure through tool
        // arguments on the critical path.
        x.fabro_tools="fabro_runs_list,fabro_workflow_version_create"
    ]

    // MERGE LEG DISABLED 2026-09-13 (user decision): fabro no longer runs
    // upstream merges; local /merge-upstream sessions own them until fabro
    // is mature enough (fabro-5082 413 run-killer; salvage cost). The node
    // and every edge referencing it are commented out so the graph view no
    // longer shows the step. Re-enable: uncomment this block, the
    // survey->merge / merge->revise / merge->exit edges below, and revert
    // the routing rule in prompts/survey.md.
    // merge [
    //     label="Merge leg",
    //     prompt="@prompts/merge-leg.md",
    //     output_schema="routing",
    //     output_retries=2,
    //     retry_policy="standard",
    //     reasoning_effort="low",
    //     project_memory=false,
    //     x.preamble_stages_ignore="survey,merge",
    //     x.fs_write="",
    //     x.fabro_tools="fabro_workflow_version_create,fabro_run_create,fabro_run_get,fabro_run_wait,fabro_runs_list"
    // ]

    // Develop leg: one seed implementation through gate+review+PR.
    develop [
        label="Develop leg",
        prompt="@prompts/develop-leg.md",
        // fabro-f84f: opt into vendored-skill discovery — the
        // session loads `.fabro/skills` (rust-style-guide and
        // friends) through the UseSkill tool.
        x.skills="discover",
        // fabro-3196: file schema (fabro-017f teeth pattern) — keeps
        // the routing contract AND rejects a revise-handoff routing
        // ('Develop integrated' / 'Gate stuck — revise anyway')
        // without a non-empty context_updates.child_run_id (run
        // 01M2X6AT3V4CPSJC08SMCVB172 dropped it; the revise leg then
        // failed pass continuity and the child went unreviewed).
        output_schema="@schemas/develop-output.schema.json",
        output_retries=2,
        retry_policy="standard",
        reasoning_effort="low",
        project_memory=false,
        x.preamble_stages_ignore="survey,develop",
        x.fs_write="",
        x.fabro_tools="fabro_workflow_version_create,fabro_run_create,fabro_run_get,fabro_run_wait,fabro_runs_list"
    ]

    // Revise leg: revisor revises the newest develop run.
    revise [
        label="Revise leg",
        prompt="@prompts/revise-leg.md",
        // fabro-f84f: opt into vendored-skill discovery — the
        // session loads `.fabro/skills` (rust-style-guide and
        // friends) through the UseSkill tool.
        x.skills="discover",
        output_schema="routing",
        output_retries=2,
        retry_policy="standard",
        reasoning_effort="low",
        project_memory=false,
        x.preamble_stages_ignore="survey,develop,revise",
        x.fs_write="",
        x.fabro_tools="fabro_workflow_version_create,fabro_run_create,fabro_run_get,fabro_run_wait,fabro_runs_list"
    ]

    start -> survey
    // survey -> merge   [label="Merge needed", condition="preferred_label=\"Merge needed\""]
    survey -> develop [label="Work", condition="preferred_label=\"Work\""]
    survey -> exit    [label="Nothing to do", condition="preferred_label=\"Nothing to do\""]
    survey -> exit    [x.kind="soft", label="Survey failed", condition="outcome=failed"]
    // Infra pass: after a merge, develop waits for the NEXT fire — but
    // the REVISE leg still runs: the merge-upstream run itself carries
    // painpoints worth filing (user directive 2026-09-05; first
    // autonomous merge 01M1SR27KEJGNQ hit an fs-policy wall worth a seed).
    // merge -> revise [label="Infra merged — revise the merge run"]
    // merge -> exit [x.kind="soft", label="Merge child failed — manual /merge-upstream", condition="preferred_label=\"Merge child failed\""]
    develop -> revise [label="Develop integrated", condition="preferred_label=\"Develop integrated\""]
    // Gate-stuck park (fabro-1dc9): the develop child SUCCEEDED but its PR
    // gate is persistently blocked after the bounded re-wait chain. The pass
    // still runs the revise leg — an unreviewed develop run is worse than a
    // parked PR; the next fire re-enters via survey.
    develop -> revise [label="Gate stuck — revise anyway", condition="preferred_label=\"Gate stuck — revise anyway\""]
    develop -> exit   [label="Tracker empty", condition="preferred_label=\"Tracker empty\""]
    develop -> exit   [x.kind="soft", label="Develop child failed", condition="preferred_label=\"Develop child failed\""]
    revise -> exit [label="Cycle complete"]
    revise -> exit [x.kind="soft", label="Revisor child failed", condition="preferred_label=\"Revisor child failed\""]
    // Unconditional safety nets (validator rule all_conditional_edges):
    // an unrouted outcome ends the pass softly — the next cron fire
    // re-enters cleanly; nothing merges on an ambiguous state.
    survey -> exit [x.kind="soft", label="Unrouted survey outcome"]
    // merge -> exit [x.kind="soft", label="Unrouted merge outcome"]
    develop -> exit [x.kind="soft", label="Unrouted develop outcome"]
    revise -> exit [x.kind="soft", label="Unrouted revise outcome"]
}
