digraph Loop {
    graph [
        goal="Maintain the loop's own machinery one seed per run: claim the next loop-assigned seed, edit workflow+prompts+scripts as one unit, gate deterministically, review, exit",
        // fabro-70b5 meta lane: this workflow maintains the loop's own
        // assets (ADR-0008 one-unit) from the 'loop' assignee queue —
        // symmetric to develop per ADR-0018. All OTHER runs keep the
        // product fs envelope; the a9bb "deterministic protection" is
        // schema-parseability (the tester battery), never a write ban.
        x.inspects="loop",
        rankdir=LR,
        // Loop-gate battery is cheap (prebuilt validate + lints, no
        // compile tier) — 33m covers LLM stages with headroom under the
        // default stall watchdog.
        stall_timeout="33m",
        max_node_visits=40,
        x.preamble_budget_kb=48
    ]

    start [shape=Mdiamond, label="Start"]
    // Exit kinds mirror develop (fabro-b907): deadlock keeps the seed
    // open for a human; soft exits re-enter on the next run.
    exit  [shape=Msquare, label="Exit"]

    // Toolchain-placement guard (fabro-3ab2): a manual `fabro run loop`
    // without --environment falls to the default sandbox image (the CLI
    // always sends an intent environment id and the intent's selection
    // outranks any [run.environment] pin, so workflow.toml cannot
    // redirect a flag-less fire) — the run then died cryptically at
    // "nu: command not found" in the next stage. POSIX sh, NOT nu: the
    // failure mode it guards is a sandbox without nu. Fail-closed with a
    // teaching error naming the correct fire command; zero effect on
    // toolchain-placed runs (passes in milliseconds).
    env_guard [
        label="Toolchain guard: fail-closed placement check",
        shape=parallelogram,
        script="sh .fabro/scripts/toolchain-guard.sh loop",
        timeout="30s",
        max_retries=0
    ]

    // ADR-0032 phase 3 (fabro-786a): the tracker_guard node is GONE —
    // its shell drained-tracker check reads the legacy .seeds queue
    // while the lane claims work items behind the server (the worker
    // env is scrubbed, no CLI surface exists). The split-brain burned a
    // full planner pass on 2026-10-23 (run 01M5KNGHH0Z: guard said
    // "non-empty" from .seeds while the central tracker binding was
    // dead). The drained case is the planner's fabro_work_next empty
    // outcome routing "Tracker empty" (one cheap LLM call, no dead
    // script arm) — develop's shape. The tracker-guard.nu script and
    // its smoke retire with this node (no graph references remain).

    // Planner preflight (ADR-0032 phase 3, fabro-786a): the develop
    // script in --work-item mode, sitting AFTER the planner (develop's
    // topology) — stdin is the granted-item packet the planner
    // forwarded (current_item_json); a missing/malformed packet IS the
    // fabro-c42f claim-contract failure (the retired claim_check node's
    // id-presence arm folded in here). The already-landed verdict runs
    // over the item key; anchor/basis/salvage flags are advisory.
    // envelope_risk stays LANE-SCOPED via --assignee loop (fabro-bd55):
    // THIS lane flags PRODUCT surfaces — the misroute detector the
    // planner prompt's surface router adjudicates.

    preflight [
        label="Claim preflight: granted-item already-landed + anchor report",
        shape=parallelogram,
        script="nu .fabro/workflows/develop/scripts/planner-preflight.nu --work-item --assignee loop",
        stdin_source="current_item_json",
        output_schema="routing",
        x.context_allow_keys="output.preflight",
        timeout="2m",
        max_retries=1
    ]

    // Planner: same shape as develop's, meta focus. The claim is the
    // fabro_work_next tool grant (engine-mediated, server-side mutex) —
    // the planner writes NOTHING to the tree (ADR-0032 phase 3: the
    // tracker left the fs envelope entirely; the frozen tracker file
    // goes back behind the hide list). Loop assets stay hidden from
    // FILE TOOLS (shell reads are the documented path for judging
    // seed-basis against assets).
    planner [
        label="Planner",
        prompt="@prompts/planner.md",
        output_schema="@schemas/planner-output.schema.json",
        output_retries=2,
        max_visits=20,
        retry_policy="standard",
        reasoning_effort="low",
        x.preamble_stages_ignore="planner,implementer,evidence",
        x.context_consume_keys="review_verdict,review_feedback,implementation_summary",
        x.fs_hide=".fabro/**,.mulch/**,.agents/**,scripts/**,justfile",
        x.context_allow_keys="current_seed_id,current_seed_title,current_seed_brief,current_item_json,review_verdict,journal",
        // fabro_run_set_title (fabro-9711/ADR-0030): refine this run's
        // title to the claimed item right after the grant. The
        // fabro_work_* catalog (ADR-0032 phase 3) is the planner's whole
        // tracker surface: next (atomic claim), show/list (reads),
        // update (stale-spec corrections), release (misroute/skip),
        // close (the two superseded-close arms) — no tracker CLI, no
        // tracker file, no forge client.
        x.fabro_tools="fabro_run_search,fabro_run_set_title,fabro_work_next,fabro_work_show,fabro_work_list,fabro_work_update,fabro_work_release,fabro_work_close,fabro_observation_record",
        // ADR-0038 flip (2026-10-31): the presence contract — the
        // session must call fabro_observation_record at least once per
        // pass (the explicit "nothing durable to record" note
        // satisfies it); a stage that never calls it is INVALID.
        x.observations="required"
    ]

    // Claim-contract gate (fabro-c42f stopgap): RETIRED with fabro-786a —
    // its id-presence arm folded into the preflight node (the packet
    // validation is the contract now, develop's shape) and its spec-paths
    // emission lives on in the tester's seed-spec-paths tier through the
    // shared lib (.fabro/scripts/lib/spec_paths.nu). The claim-check.nu
    // script and its smoke retire with this node (no graph references
    // remain; the 2026-10-24 arm-1 fix rode its final lap as the 9986
    // acceptance).

    // Implementer: edits the loop's own machinery. fs_write pins EXACTLY
    // the loop-asset set (the smoke pins the pair against
    // scripts/qualitygate.nu's loop-asset?) plus the ONE lib/ exception
    // (fabro-9973): the fabro-dot snapshot directory the dot-snapshot
    // gate tier asks the lane to accept after a workflow-graph shape
    // change — mechanically derived from .fabro/workflows, never
    // product code. fs_hide is REDUCED to the
    // session-level surfaces (.agents skills, .mulch expertise — ml
    // writes are not loop work) — the meta lane must SEE and EDIT loop
    // assets with file tools (the a9bb user decision: deterministic
    // protection means schema-parseability, never a write ban).
    // No lesson_capture contract: mulch is hidden, so loop lessons land
    // as journal painpoints (the revisor files them as seeds).
    implementer [
        label="Implementer",
        prompt="@prompts/implementer.md",
        output_schema="routing",
        output_retries=2,
        max_visits=10,
        fidelity="summary:high",
        reasoning_effort="low",
        retry_policy="standard",
        x.preamble_stages_ignore="planner,reviewer,implementer",
        x.preamble_stages_latest_only=true,
        x.tools="read_file,write_file,edit_file,glob,grep,shell,use_skill",
        // ADR-0032 phase 3: the read-only work-item pair — show resolves
        // a thin brief (the full granted item), list is the known-bug
        // query surface on gate-red bounces. Writes stay denied; no
        // tracker CLI, no forge client.
        x.fabro_tools="fabro_work_show,fabro_work_list,fabro_observation_record",
        // ADR-0038 flip (2026-10-31): the presence contract — see the
        // planner node's comment.
        x.observations="required",
        x.preamble_allow_keys="current_seed_id,current_seed_title,current_seed_brief",
        x.fs_hide=".agents/**,.mulch/**",
        // The tracker left the fs envelope with .seeds (denkhaus/work#990
        // swept the residual write grants): filings and closes go through
        // the capability channel, never through tree writes.
        x.fs_write=".fabro/**,scripts/**,justfile,lib/components/fabro-dot/src/snapshots/**",
        x.context_allow_keys="implementation_summary,journal"
    ]

    // Tester: the deterministic loop battery (fabro-70b5 part C) —
    // validate every graph, the ONE battery-runner surface
    // (fabro-eae5: lint-nu + prompt-lint + every registered
    // loop-asset battery, shared with the product gate), run-scope
    // (loop lane), exec-bit preservation, the fabro-dot snapshot tier
    // when the diff changes a workflow graph (fabro-9973 — the one
    // bounded Rust probe; it may cold-compile one crate, hence the
    // wider timeout), fmt only if .rs files appear. NEVER the product
    // compile tier: clippy/nextest belong to develop.
    tester [
        label="Loop Gate",
        shape=parallelogram,
        script="nu .fabro/workflows/loop/scripts/loop-gate.nu",
        timeout="20m",
        max_retries=1
    ]

    // Evidence: the develop script with --lane loop — loop assets ARE
    // the review scope; out-of-lane paths surface in the anomaly
    // section for the reviewer to adjudicate. ADR-0032 phase 3: stdin
    // is the granted-item packet (current_item_json, planner-forwarded
    // from its fabro_work_next tool result) — the capture resolves spec
    // and diff base for EXACTLY this run's item (develop's wiring).
    evidence [
        label="Evidence",
        shape=parallelogram,
        script="nu .fabro/workflows/develop/scripts/evidence.nu --lane loop --work-item",
        stdin_source="current_item_json",
        timeout="2m",
        max_retries=1
    ]

    // Reviewer: read-only by engine enforcement, same posture as
    // develop's (tools allow-list + empty fs_write). Judges the loop-work
    // diff against the seed spec: ADR-0008 one-unit completeness, prompt
    // hygiene, ADR-0019 capability gate on agent-reachable surfaces.
    reviewer [
        label="Reviewer",
        prompt="@prompts/reviewer.md",
        fidelity="summary:high",
        reasoning_effort="low",
        x.preamble_stages_ignore="planner,implementer,reviewer",
        x.preamble_stages_latest_only=true,
        x.preamble_allow_keys="current_seed_id,current_seed_title,current_seed_brief,implementation_summary,command.output",
        x.context_allow_keys="review_verdict,review_feedback,journal",
        // fabro-31f7: the stage Output render is a TAIL cap — at 200 a
        // 475-line loop evidence capture lost its first 275 lines (the
        // integrity header and new-script heads) to "(275 lines
        // omitted)". 2000 keeps realistic captures whole; pathological
        // sizes stay evidence.nu's HARD_CAP disclosure. Pinned by the
        // loop graph-contract smoke (contract 10).
        x.preamble_inline_max_kb=16,
        x.preamble_output_max_lines=2000,
        x.fs_write="",
        x.tools="read_file,grep,glob",
        // ADR-0032 phase 3: read-only item access — the claimed item's
        // title/body/state by key, the spec source when the capture's
        // spec section is thin. Never a write: claiming, closing,
        // editing, or filing is other roles' business.
        x.fabro_tools="fabro_work_show,fabro_observation_record",
        // ADR-0038 flip (2026-10-31): the presence contract — see the
        // planner node's comment.
        x.observations="required",
        output_schema="routing",
        output_retries=2,
        max_visits=20,
        retry_policy="standard"
    ]

    // Closeout: post-approval bookkeeping (ADR-0010), deterministic
    // again since denkhaus/work#990 — the capability channel carries
    // the tracker calls (`fabro work` over FABRO_RUN_CHANNEL_SOCK with
    // the run's principal, claim-bound by #991), so the fork-7/8 agent
    // split collapses back into the script: granted-item packet on
    // stdin, PARK gate, the three advisory sweeps as direct filings
    // (lane:loop puts every filed residual back into THIS lane's
    // queue), then the claim-bound close.
    closeout [
        label="Closeout",
        shape=parallelogram,
        script="nu .fabro/workflows/develop/scripts/closeout.nu --work-item --lane loop",
        stdin_source="current_item_json",
        timeout="3m",
        max_retries=1
    ]

    start -> env_guard
    env_guard -> planner

    planner -> exit [label="Tracker empty", condition="preferred_label=\"Tracker empty\""]
    planner -> exit [label="Already landed", condition="preferred_label=\"Already landed\""]
    planner -> exit [x.kind="deadlock", label="Blocked", condition="preferred_label=\"Blocked\""]
    // A planner death is a soft stop, never a green pass (run
    // 01M4NSBKV6ZBPAFFEFND65HEP9): Failed{SoftStop} counts toward the
    // breaker and reads resumable, where the plain edge concluded green
    // and reset the breaker on every rate-limited pass.
    planner -> exit        [x.kind="soft", label="Planner failed (next run re-enters)", condition="outcome=failed"]
    planner -> evidence [label="Verification-only", condition="preferred_label=\"Verification-only\""]
    // Contract retry (fabro-c42f class): a planner response that
    // validates routing but drops its context_updates bounces at the
    // preflight's packet validation — re-entering the planner gives the
    // claim a second chance instead of parking the pass (graph
    // max_node_visits caps the loop).
    planner -> preflight [label="Seed claimed"]
    preflight -> implementer [label="Preflight done"]
    preflight -> planner [label="Claim contract failed, re-plan", condition="outcome=failed"]

    implementer -> planner  [label="Blocked", condition="outcome=failed"]
    implementer -> tester   [label="Implemented"]

    tester -> evidence    [label="Gate green", condition="outcome=succeeded"]
    // Structural gate-guard (fabro-6baf, restored denkhaus/work#1057):
    // the third consecutive red routes to the human — the bounce below
    // excludes generation >= 2 (cap 2, not 3: the circuit breaker cuts
    // the third loop signature before a >= 3 guard fires — probe-30),
    // so the third red matches no conditional edge and lands here on
    // the UNCONDITIONAL fallback the engine requires
    // (attractor.all_conditional_edges), which also catches unroutable
    // outcomes the same way. #1029's fallback resolution had silently
    // dropped the generation guard.
    tester -> exit [x.kind="deadlock", label="Gate deadlock (3 reds or unroutable outcome, needs a human)"]
    // No gatebounce node in the loop lane: the implementer reads the
    // tester stage section directly (preamble keeps tester) and the
    // battery output is small enough to inline.
    // EXPLICIT conditional (work#1029, run 01M5ZEWKAMMZ): an
    // unconditional bounce edge made the b00c fake-green fold downgrade
    // a completed develop run to failed/workflow_error while the engine
    // concluded success — status split, publish skipped. The bounce is
    // deliberate control flow and must declare itself. The generation
    // cap (work#1057) keeps the deadlock guard above reachable: a red at
    // generation >= 2 matches no conditional edge and exits to the human
    // (`&&` composition as on the reviewer's Verification-blocked edge).
    tester -> implementer [label="Gate red", condition="outcome=failed && nodes.tester.generation < 2"]

    evidence -> reviewer [label="Evidence ready", condition="outcome=succeeded"]
    evidence -> exit [x.kind="soft", label="Capture failed (next run re-enters)"]

    reviewer -> closeout  [label="Approved", condition="preferred_label=\"Approved\""]
    reviewer -> exit [x.kind="deadlock", label="Review deadlock (3 cycles, needs a human)", condition="nodes.reviewer.generation >= 3"]
    reviewer -> planner   [label="Changes requested"]
    reviewer -> evidence  [label="Verification blocked", condition="preferred_label=\"Verification blocked\" && nodes.evidence.generation < 2"]
    reviewer -> exit [x.kind="soft", label="Reviewer failed (next run re-enters)", condition="outcome=failed"]

    closeout -> exit [label="Item closed"]
    closeout -> exit [x.kind="soft", label="Closeout failed (item stays open)", condition="outcome=failed"]
}
