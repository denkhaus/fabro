// The running system BEFORE the adjudicator chain goes live: the two
// retiring authorities (closeout closes, merger closes) that ADR-0039
// moves. Compare with the `lifecycle` view to see exactly what changes.

views "Orchestration" {
  dynamic view today {
    title "Today — interim flow before the adjudicator"
    description '''
      The live system while the adjudicator chain is being built: the
      run still closes its own item (closeout) and the run-PR merger
      lands and closes. These are the authorities ADR-0039 takes away
      — the adjudicator becomes the only closer.
    '''
    fabro.orchestration.scheduler -> fabro.orchestration.conductor "tick"
    fabro.orchestration.conductor -> fabro.records.work-ledger "picks next item"
    fabro.orchestration.conductor -> fabro.orchestration.develop "spawns ONE develop run"
    fabro.orchestration.develop -> fabro.records.work-ledger "claims item (fabro_work_next)"
    fabro.orchestration.develop -> fabro.orchestration.develop "plan → implement → test → review"
    fabro.orchestration.develop -> fabro.records.observation-records "files observations"
    fabro.orchestration.develop -> github "opens PR"
    fabro.orchestration.develop -> fabro.records.work-ledger "closeout CLOSES its own item + files follow-ups"
    fabro.orchestration.scheduler -> fabro.orchestration.merger "tick"
    fabro.orchestration.merger -> github "lands PRs window-gated, base-first"
    fabro.orchestration.merger -> fabro.records.work-ledger "lands claim + closes item"
    loop "background, every ~30 s" {
      fabro.orchestration.reconciler -> fabro.records.work-ledger "heals ledger + outbox"
      fabro.orchestration.reconciler -> github "heals tracker projection"
    }
  }
}
