// Level 2 (control plane): the three serial scheduler gears of
// ADR-0039 — item-driven develop, run-driven adjudicator,
// merge-marker-driven merger — plus the reconciler that heals beneath
// them.
//
// Status tags record where the ADR-0039 restructuring stands:
//   #planned  — not built yet (substrate may have landed)
//   #evolving — live in predecessor form, rework pending
//   #retiring — edge/authority that ADR-0039 removes

model {
  extend fabro {
    orchestration = subsystem "Orchestration" {
      description '''
        Three serial scheduler gears, each with its own tick and
        on_overlap: skip, coupled ONLY through the dataset fields on the
        run record. The serial tick never blocks on a human; a dead-man
        watch alarms when a gear makes no progress (ADR-0039 decision 9).
      '''
      link ../../docs/adr/0039-internal-integration-adjudicator-merger.md

      scheduler = service "Scheduler" {
        description '''
          The automation scheduler: fires each gear's tick. One overlap
          policy for every gear: skip — never two passes of one gear,
          never a blocked tick.
        '''
        metadata {
          status "live"
          code "lib/apps/fabro-server/src/server/automation_scheduler.rs"
        }
      }

      develop = workflow "Develop run — the unit of work" {
        description '''
          planner → preflight → implementer → tester → evidence →
          reviewer → reporter. Its end product is a pull request
          carrying the performed work. It never closes its item, never
          files follow-ups, never judges itself (ADR-0039 decision 1).
          Verification runs inside fabro — GitHub automerge and CI
          gates retire completely.
        '''
        metadata {
          status "live"
          code ".fabro/workflows/develop"
        }
        link ../../.fabro/workflows/develop/workflow.fabro

        reporter = workflow "Reporter stage" {
          description '''
            The develop run's facts-only final stage, renamed from
            closeout: reports patch visibility and Dockerfile touches as
            observation records. The run reports facts; it never judges
            (ADR-0039 decision 10). The stage-G cutover (2026-11-06)
            stripped the close authority, the park gate, and the marker
            sweeps — residuals, deferred actions, and EXEMPTION arms
            ride painpoint observation records to the adjudicator's
            agent pass now.
          '''
          link ../../docs/adr/0039-internal-integration-adjudicator-merger.md
        }
      }

      adjudicator = workflow "Adjudicator" {
        #evolving
        description '''
          Run-driven, serial, HITL. Pass 1: reviews the observations of
          ALL runs of an item one after another, reconciles painpoints,
          markers and notes, files follow-up items, watches the closure
          radius, asks the operator on policy forks (park + resume) and
          marks `merge` on the run record. Pass 2 — once the merger
          marked `closable: enabled` — closes the item. The ONLY closer.
          A mechanical fast path handles the trivial case without an
          LLM call.
        '''
        metadata {
          substrate "graph + all four read doors + the mark door landed (stage D, 2026-11-02); manual fire until the stage-F scheduler tick; the sandbox CLI legs wait for the fork.30 toolchain pin (probe-39)"
          epic "denkhaus/work#1107"
        }
        link ../../docs/adr/0039-internal-integration-adjudicator-merger.md

        // --- internals (detail level, shown in the adjudicator view) ---

        fast-path = stage "Mechanical fast path" {
          #evolving
          description '''
            The trivial case — no markers, no painpoints, empty radius —
            is decided and closed mechanically, without an LLM call
            (ADR-0039 decision 7).
          '''
        }

        review-pass = stage "Review pass (pass 1)" {
          #evolving
          description '''
            Reviews the observations of ALL runs of the item one after
            another; reconciles painpoints, markers and notes; files
            follow-up items; marks merge = enabled | refused on the run
            record.
          '''
        }

        radius-watch = stage "Closure-radius watch" {
          #evolving
          description '''
            Watches the closure radius: the open work items linked to
            the observations of the item's runs (work item ←
            observation ← run, ADR-0037/0038).
          '''
          link ../../docs/adr/0037-work-item-closure-radius.md
        }

        park-resume = stage "Operator ask & park/resume" {
          #evolving
          description '''
            The HITL corridor: the pass runs autonomously for clear
            cases; a true policy fork triggers an operator ask; no
            answer within the pass parks the run and pings Slack; the
            next pass resumes. The parked-runs Kanban column (#1110)
            and the HITL instruments (#1111) are filed follow-ups.
          '''
        }

        closing-pass = stage "Closing pass (pass 2)" {
          #evolving
          description '''
            Once the merger marked closable = enabled, closes the item —
            the ONLY closer in the system. Landed with stage E
            (2026-11-03): a mechanical script stage reading the
            verdict-flipped queue (`closable = enabled`), closing every
            claimed entry whose radius is empty; the close lands the
            claim server-side (merge-complete). The door's own
            refusals make the sweep idempotent (no live claim =
            already closed; open radius = retry next pass). Manual fire
            until the stage-F scheduler tick; the CLI legs wait for
            the fork.30 toolchain pin.
          '''
        }
      }

      merger = workflow "Merger" {
        #evolving
        description '''
          Merge-marker-driven. Integrates every merge-enabled run of a
          repo/project — serializes, merges, resolves conflicts — and
          marks `closable` on the run record. Owns technical
          integration, never the content verdict; parks on unresolvable
          conflicts. Landed with stage E (2026-11-03): the workflow
          graph (guard → fast path → resolve agent pass, soft exits)
          merges through the platform door (squash, server-side
          credentials) and smokes every integrated tree (cargo check);
          the ADR-0031 run-PR supervisor is retired. Manual fire until
          the stage-F scheduler tick; the CLI legs wait for the
          fork.30 toolchain pin (probe-40).
        '''
        metadata {
          status "graph + merge door landed (stage E, 2026-11-03); manual fire until the stage-F tick"
          code ".fabro/workflows/merger"
        }
        link ../../docs/adr/0039-internal-integration-adjudicator-merger.md
      }

      reconciler = service "Work reconciler" {
        description '''
          One periodic pass per project (~30 s), all directions: heals
          the claim ledger, the tracker projection and the outbox after
          crashes and outages; moves terminal runs to awaiting_merge or
          release. Its outbox/reconciler discipline returns as the
          adjudicator's fast-path reliability pattern (ADR-0039).
        '''
        metadata {
          status "live"
          code "lib/apps/fabro-server/src/server/work_reconciler.rs"
        }
        link ../../docs/adr/0032-central-work-item-tracker.md
      }

      watchdog = workflow "Watchdog" {
        #evolving
        description '''
          The dead-man watch (ADR-0039 decision 9, stage F 2026-11-05):
          an LLM-free workflow on its own hourly tick that reads every
          gear's automation state and pass history through the read
          doors (`fabro automations list`, `fabro ps -a`) and ALARMS by
          failing its own run — the Slack lifecycle notification carries
          the alarm. A gear stalls when its automation is ENABLED and no
          completed pass sits within 3x its tick interval. A disabled
          gear stays silent: the user pause is authoritative. Nothing
          watches the watchdog — its automation row and `fabro ps -a
          --workflow watchdog` carry the meta-stall visibility (grilled:
          list visibility).
        '''
        metadata {
          status "graph + stall check landed (stage F, 2026-11-05); hourly automation created at the fork.30 cutover"
          code ".fabro/workflows/watchdog"
        }
        link ../../docs/adr/0039-internal-integration-adjudicator-merger.md
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Wiring. Full FQNs on purpose: relationships are the coupling story of
// ADR-0039 and should read uniformly, regardless of file scope.

model {
  // --- ticks (ADR-0039 decision 9: three serial gears; the conductor
  // dissolved at the stage-G cutover — the develop gear fires directly,
  // its planner picks the claimable item in-run) ------------------------
  fabro.orchestration.scheduler -[trigger]-> fabro.orchestration.develop "tick — item-driven, direct fire (stage G)"
  fabro.orchestration.scheduler -[trigger]-> fabro.orchestration.adjudicator "tick — run-driven"
  fabro.orchestration.scheduler -[trigger]-> fabro.orchestration.merger "tick — merge-marker-driven"

  // --- develop ------------------------------------------------------------
  fabro.orchestration.develop -[claim]-> fabro.run-substrate.work-item-surface "claims via fabro_work_next (atomic claim mutex)"
  fabro.orchestration.develop -[uses]-> llm-providers "agent stages: plan → implement → test → review"
  fabro.orchestration.develop -[create]-> github "opens the PR — artifact only, never a gate"
  fabro.orchestration.develop.reporter -[report]-> fabro.run-substrate.observation-record-surface "reports facts: patch visibility, Dockerfile touches"

  // --- adjudicator ---------------------------------------------------------
  // Edges live at the OWNING stage (single source). Views that show the
  // adjudicator collapsed aggregate these automatically — there are no
  // duplicate parent-level edges.
  fabro.orchestration.adjudicator.review-pass -[review]-> fabro.records.observation-records "reviews all runs' observations, one after another"
  fabro.orchestration.adjudicator.review-pass -[uses]-> llm-providers "the judgment call — the only LLM step in the chain"
  fabro.orchestration.adjudicator.review-pass -[write]-> fabro.run-substrate.orchestration-mark-surface "marks merge = enabled | refused"
  fabro.orchestration.adjudicator.review-pass -[create]-> fabro.run-substrate.work-item-surface "files follow-up items, linked to the observations (provenance)"
  fabro.orchestration.adjudicator.fast-path -[write]-> fabro.run-substrate.orchestration-mark-surface "merge: enabled — mechanically, no LLM"
  fabro.orchestration.adjudicator.radius-watch -[read]-> fabro.records.observation-records "radius chain: linked observations"
  fabro.orchestration.adjudicator.radius-watch -[read]-> fabro.records.work-ledger "open items in the radius"
  fabro.orchestration.adjudicator.park-resume -[ask]-> operator "policy ask"
  fabro.orchestration.adjudicator.park-resume -[notify]-> slack "park ping; next pass resumes"
  fabro.orchestration.adjudicator.closing-pass -[read]-> fabro.records.run-record "gate: closable = enabled"
  fabro.orchestration.adjudicator.closing-pass -[close]-> fabro.run-substrate.work-item-surface "closes the item — the ONLY closer"

  // --- merger --------------------------------------------------------------
  fabro.orchestration.merger -[read]-> fabro.records.run-record "reads its queue: merge-enabled runs"
  fabro.orchestration.merger -[write]-> fabro.run-substrate.orchestration-mark-surface "writes closable = enabled | parked"
  fabro.orchestration.merger -[integrate]-> github "merges through the door (squash, server-side credentials), resolves conflicts on the run branch, smokes the integrated tree"

  // --- reconciler & watch --------------------------------------------------
  fabro.orchestration.reconciler -[heal]-> fabro.records.work-ledger "heals ledger, drains outbox"
  fabro.orchestration.reconciler -[heal]-> github "heals tracker projection (labels)"
  fabro.orchestration.reconciler -[read]-> fabro.records.run-record "terminal runs → awaiting_merge | release"
  fabro.orchestration.scheduler -[trigger]-> fabro.orchestration.watchdog "tick — hourly, the watch's own gear"
  fabro.orchestration.watchdog -[read]-> fabro.orchestration.scheduler "gear automation state (enabled? the pause is authoritative)"
  fabro.orchestration.watchdog -[read]-> fabro.records.run-record "last completed pass per gear (ps -a)"
  fabro.orchestration.watchdog -[notify]-> slack "the alarm IS the failed watchdog run — Slack lifecycle notification"

  // --- operator ------------------------------------------------------------
  operator -[create]-> github "files work items (painpoints channel)"
}
